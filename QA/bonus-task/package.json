{
    "name": "fulll-bonus-task",
    "version": "1.0.0",
    "description": "Bonus E2E automation for Fulll.fr website (Non-iframe interactions)",
    "main": "index.js",
    "scripts": {
        "test": "npx cypress run",
        "test:allure": "npx cypress run && npm run allure:report && npm run allure:open",
        "cypress:open": "npx cypress open",
        "allure:report": "allure generate allure-results --clean -o allure-report",
        "allure:open": "allure open allure-report",
        "allure:clear": "rm -rf allure-results allure-report"
    },
    "devDependencies": {
        "@badeball/cypress-cucumber-preprocessor": "^21.0.0",
        "@bahmutov/cypress-esbuild-preprocessor": "^2.2.0",
        "allure-cypress": "^3.0.0",
        "cypress": "^13.13.0",
        "typescript": "^5.5.0"
    }
}